# Browser-visible backend URL (or same-origin path). No credentials.
NUXT_PUBLIC_API_BASE=/api
# Optional server-only backend override, e.g. http://backend:8080/api
NUXT_API_BASE=

# Enable only on a real production domain configured in shared/data/site.ts.
NUXT_INDEXING_ENABLED=false

# Server-only administrator account. Set your own credentials in .env.
NUXT_ADMIN_EMAIL=
NUXT_ADMIN_PASSWORD=
NUXT_ADMIN_NAME=Administrator

# Customer auth provider is selected independently in site.features.customer.
# Optional provisioned local customer. Registration works without these.
NUXT_CUSTOMER_EMAIL=
NUXT_CUSTOMER_PASSWORD=
NUXT_CUSTOMER_NAME=Customer
# Private persistent SQLite path; keep it outside public/ and back it up.
NUXT_CUSTOMER_DATABASE=.data/customer-auth.sqlite

# Legacy/private local admin storage. Public editorial rows are imported once into PostgreSQL;
# private messages, subscriptions, applications and auth settings remain in this SQLite file.
NUXT_MANAGEMENT_DATABASE=.data/management.sqlite

# Active local private-upload provider. Keep both paths outside public/.
NUXT_UPLOAD_STORAGE_DATABASE=.data/uploads.sqlite
NUXT_UPLOAD_STORAGE_DIRECTORY=.data/uploads/objects

# ---------------------------------------------------------------------------
# SERVER INTEGRATIONS: private runtime configuration.
# PostgreSQL is implemented; the hosted processor/email/upload adapters remain reserved.
# Credentials alone do not activate an adapter; select a supported driver/provider too.
# Private/local stores still use NUXT_CUSTOMER_DATABASE / NUXT_MANAGEMENT_DATABASE above.
# Never use NUXT_PUBLIC_ for credentials. Prefer a deployment secret manager in production.
# Built Node servers do not automatically read .env: inject environment variables at runtime.
# See docs/configuration-and-secrets.md and docs/integration-audit.md.
# ---------------------------------------------------------------------------

# PostgreSQL stores blog posts, events, reviews, business information, FAQs, media and ratings.
# Workflows remain memory-backed until their repository migration.
NUXT_INTEGRATIONS_DATABASE_DRIVER=memory
# Full DSN; secret when it contains a password. Use postgres only with a non-empty URL.
NUXT_INTEGRATIONS_DATABASE_URL=
# Local development may use disable/prefer; production should use verify-full.
NUXT_INTEGRATIONS_DATABASE_TLS=verify-full
NUXT_INTEGRATIONS_DATABASE_POOL_MAX=10

# Future shared sessions/rate limits (current sessions are process-local).
NUXT_INTEGRATIONS_SESSIONS_DRIVER=memory
NUXT_INTEGRATIONS_SESSIONS_REDIS_URL=
# Reserved for a future signing/sealing adapter, not used by current opaque sessions.
NUXT_INTEGRATIONS_SESSIONS_SIGNING_SECRET=

# Hosted checkout placeholders. Current workflow remains a card-free demo.
NUXT_INTEGRATIONS_PAYMENTS_PROVIDER=demo
NUXT_INTEGRATIONS_PAYMENTS_ENVIRONMENT=sandbox
# Square: keep sandbox and production credentials in separate deployment environments.
NUXT_INTEGRATIONS_PAYMENTS_SQUARE_APPLICATION_ID=
NUXT_INTEGRATIONS_PAYMENTS_SQUARE_LOCATION_ID=
NUXT_INTEGRATIONS_PAYMENTS_SQUARE_ACCESS_TOKEN=
NUXT_INTEGRATIONS_PAYMENTS_SQUARE_WEBHOOK_SIGNATURE_KEY=
# Exact public HTTPS notification URL registered with Square; used in signature verification.
NUXT_INTEGRATIONS_PAYMENTS_SQUARE_WEBHOOK_NOTIFICATION_URL=
# Stripe: use test credentials first. Webhook signing secret is separate from the API key.
# Prefer a restricted server key with only the permissions the eventual adapter needs.
NUXT_INTEGRATIONS_PAYMENTS_STRIPE_PUBLISHABLE_KEY=
NUXT_INTEGRATIONS_PAYMENTS_STRIPE_SECRET_KEY=
NUXT_INTEGRATIONS_PAYMENTS_STRIPE_WEBHOOK_SECRET=

# Transactional email / SMTP; no sender or delivery worker exists yet.
NUXT_INTEGRATIONS_EMAIL_PROVIDER=none
NUXT_INTEGRATIONS_EMAIL_FROM=
NUXT_INTEGRATIONS_EMAIL_REPLY_TO=
NUXT_INTEGRATIONS_EMAIL_API_KEY=
NUXT_INTEGRATIONS_EMAIL_SMTP_HOST=
NUXT_INTEGRATIONS_EMAIL_SMTP_PORT=587
NUXT_INTEGRATIONS_EMAIL_SMTP_USER=
NUXT_INTEGRATIONS_EMAIL_SMTP_PASSWORD=
NUXT_INTEGRATIONS_EMAIL_WEBHOOK_SECRET=

# Newsletter provider: delivery, confirmation/unsubscribe and webhook processing are future work.
NUXT_INTEGRATIONS_NEWSLETTER_PROVIDER=none
NUXT_INTEGRATIONS_NEWSLETTER_API_KEY=
NUXT_INTEGRATIONS_NEWSLETTER_LIST_ID=
NUXT_INTEGRATIONS_NEWSLETTER_WEBHOOK_SECRET=

# Private object storage: prefer workload identity over static credentials where supported.
NUXT_INTEGRATIONS_UPLOADS_PROVIDER=none
NUXT_INTEGRATIONS_UPLOADS_BUCKET=
NUXT_INTEGRATIONS_UPLOADS_REGION=
NUXT_INTEGRATIONS_UPLOADS_ENDPOINT=
NUXT_INTEGRATIONS_UPLOADS_ACCESS_KEY_ID=
NUXT_INTEGRATIONS_UPLOADS_SECRET_ACCESS_KEY=

# Future identity providers. Do not commit a Firebase credentials JSON file.
NUXT_INTEGRATIONS_IDENTITY_FIREBASE_PROJECT_ID=
# Optional private file path mounted by the deployment; use managed credentials if possible.
NUXT_INTEGRATIONS_IDENTITY_FIREBASE_CREDENTIALS_FILE=
NUXT_INTEGRATIONS_IDENTITY_SUPABASE_URL=
NUXT_INTEGRATIONS_IDENTITY_SUPABASE_SERVICE_KEY=

# Optional remote public-content search index (never index private account/admin records).
NUXT_INTEGRATIONS_SEARCH_PROVIDER=local
NUXT_INTEGRATIONS_SEARCH_ENDPOINT=
NUXT_INTEGRATIONS_SEARCH_INDEX=
NUXT_INTEGRATIONS_SEARCH_API_KEY=

# Future bot protection. A site key can be exposed separately once a provider is installed.
NUXT_INTEGRATIONS_SPAM_PROVIDER=none
NUXT_INTEGRATIONS_SPAM_SITE_KEY=
NUXT_INTEGRATIONS_SPAM_SECRET_KEY=

# Optional server telemetry; redact PII, tokens, DSNs and request bodies.
NUXT_INTEGRATIONS_OBSERVABILITY_ENDPOINT=
NUXT_INTEGRATIONS_OBSERVABILITY_AUTH_TOKEN=

# Secret resolver / future encrypted database credential vault.
NUXT_INTEGRATIONS_SECRETS_PROVIDER=environment
# RESERVED, currently unused. No reversible hashing or encrypted credential table exists.
# Future authenticated encryption needs a versioned key ID and a key stored OUTSIDE the database.
# Prefer a managed KMS key to a self-managed encryption key; do not set both without an adapter policy.
NUXT_INTEGRATIONS_SECRETS_ENCRYPTION_KEY_ID=
NUXT_INTEGRATIONS_SECRETS_ENCRYPTION_KEY=
NUXT_INTEGRATIONS_SECRETS_KMS_KEY_ID=
